# ---- 서버 (packages/server) ----
PORT=8787
AWS_REGION=us-east-1
# AWS_PROFILE=default            # 기본 credential chain 사용 시 생략
S3_BUCKET=minutes-dev-367833968741
DATA_DIR=./data                  # SQLite 파일 위치 (git 제외)

# 전사
TRANSCRIBE_LANGUAGE=ko-KR        # 또는 "auto" → ko-KR/en-US 자동 식별
TRANSCRIBE_MAX_SPEAKERS=6

# 정밀 전사 (Qwen3-ASR). 비워 두면 REFINING 단계는 건너뜀.
# OpenAI 호환 /v1/audio/transcriptions 엔드포인트 (vLLM 등) 또는 DashScope.
QWEN_ASR_URL=
QWEN_ASR_API_KEY=
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# 노트 생성 / 전사 보정 (Bedrock)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# 로컬 개발용 세션 (Cognito 대신). 배포 시 Cognito로 교체.
DEV_USER_SUB=local-dev
DEV_USER_NAME=개발자
DEV_USER_EMAIL=dev@example.com
DEV_USER_TEAMS=my-team
DEV_USER_ADMIN=true

# 브라우저 origin (presigned URL CORS와 일치해야 함)
WEB_ORIGIN=http://localhost:5173
